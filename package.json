{
  "name": "c-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "C-Studio \u2014 professional, tablet-first C IDE for the web",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix backend run dev",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:backend": "npm --prefix backend test",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:browser": "node e2e/browser-engine.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@yowasp/clang": "22.0.0-git20695-13",
    "jszip": "^3.10.2",
    "lucide-react": "^1.80.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "5.7",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
